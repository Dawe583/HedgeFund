# Aurelio's backend settings. Copy this file to backend/.env and fill in what
# you need: only OPENROUTER_API_KEY is needed, and only by the chat and the
# analysis. backend/.env is ignored by git; this template is not, so never put
# a real key in it.

# OpenRouter, the gateway the chat and the analysis talk to. Get a key at
# https://openrouter.ai/keys, and put the real key only in backend/.env.
OPENROUTER_API_KEY=

# Optional: the model, as a slug from https://openrouter.ai/models
# (default if empty: anthropic/claude-opus-5.5)
OPENROUTER_MODEL=

# Optional: give each role of the analysis its own model. Different models
# bring different blind spots, which is the point of a panel; leaving these
# empty runs every role on OPENROUTER_MODEL, and the analysis still works
# because the asymmetry is in the context each role receives, not in the
# weights.
#   analyst: judges the portfolio blind (quantitative work)
#   confidant: knows the person, never sees the figures (reads people, words)
# Slugs checked in Aug 2026: moonshotai/kimi-k3 ($3/$15 per 1M tokens, 1M ctx),
# moonshotai/kimi-k2.6 (about 6x cheaper), anthropic/claude-sonnet-4.6.
# Checked in Oct 2026: anthropic/claude-opus-5.5 ($4/$20, 1M ctx),
# openai/gpt-6.1-sol-pro ($2/$10, 1.05M ctx), qwen/qwen3.8-max-0902 ($2/$6).
OPENROUTER_ANALYST_MODEL=
OPENROUTER_CONFIDANT_MODEL=

# Optional: the model the chat panel answers with when nothing is picked in its
# menu (falls back to OPENROUTER_MODEL). The default errs large, because a
# wrong number about your money costs more than a slow answer.
OPENROUTER_CHAT_MODEL=

# Optional: another SQLite database. Default: backend/data.db.
# ./start.ps1 -Demo and ./start.sh --demo point it at backend/demo.db for you.
# DATABASE_URL=sqlite:///path/to/another.db

# ---------------------------------------------------------------------------
# Trading engine (trading/ — the paper-trading desk ported from ScalpFX, M0).
# Nothing in this section is needed for tests or for the wealth app; the
# paper engine is not wired into the FastAPI app yet, so these matter only
# once the engine process runs. All variables take the TRADING_ prefix.

# Optional: OpenRouter key for the trading agents (analyst/reviewer/prime).
# Free-tier models only; without a key every agent falls back to its
# deterministic heuristic, by design.
# TRADING_OPENROUTER_API_KEY=

# Optional: which database the engine writes. Default: backend/data.db
# (the shared platform database, design D3). Point it elsewhere only for
# scratch experiments — never at a copy you care about.
# TRADING_DATABASE_URL=sqlite:///path/to/scratch.db

# Optional: scratch directory for budget counters and the worker lock.
# Default: backend/data
# TRADING_DATA_DIR=./data

# Optional: bearer token protecting the engine's privileged endpoints
# (kill-switch, manual ticks) once the API is mounted.
# TRADING_ENGINE_TOKEN=

# Live trading is a hard gate, off by default, and no live venue is ported
# in M0. These stay as documentation of the gate, not as an invitation:
# TRADING_LIVE_TRADING=false
